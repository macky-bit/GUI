<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

    <!--
      MySQL connection used by the portal. Edit Uid and Pwd to match your own
      MySQL account, then restart the app. The schema and tables are created
      automatically on first run, so nothing has to be set up in Workbench.
    -->
    <connectionStrings>
        <add name="MaintenanceDb"
             connectionString="Server=localhost;Port=3306;Uid=root;Pwd=;SslMode=None;AllowPublicKeyRetrieval=True;Convert Zero Datetime=True;Default Command Timeout=30;Connection Timeout=10"
             providerName="MySql.Data.MySqlClient" />
    </connectionStrings>
</configuration>
